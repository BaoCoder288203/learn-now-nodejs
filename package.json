{
  "name": "learn-now-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/index.js",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/services/imageCropService.test.ts src/services/toeicScoringService.test.ts src/services/toeicRuleParser/keyRc.test.ts src/services/toeicRuleParser/listening.test.ts src/services/toeicRuleParser/columnLayout.test.ts src/services/toeicRuleParser/layoutBbox.test.ts src/services/toeicRuleParser/de3.integration.test.ts src/services/toeicRuleParser/de4.integration.test.ts src/services/toeicRuleParser/de5.integration.test.ts src/services/pymupdfClient.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@aws-sdk/s3-request-presigner": "^3.1054.0",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "headroom-ai": "^0.22.4",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.8",
    "openai": "^6.39.1",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^6.1.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "esbuild": "^0.25.0",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
