datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  password         String
  name             String
  dateOfBirth      DateTime?
  gender           String?
  role             String           @default("USER")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  testAttempts     TestAttempt[]
  selectedWords    SelectedWord[]
  userVocabularies UserVocabulary[]
  ingestionJobs    IngestionJob[]
}

model Test {
  id            String         @id @default(uuid())
  title         String
  description   String?
  examType      String         @default("TOEIC")
  published     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  parts         TestPart[]
  testAttempts  TestAttempt[]
  uploadedFiles UploadedFile[]
  ingestionJobs IngestionJob[]
}

enum IngestionStatus {
  QUEUED
  EXTRACTING
  CLASSIFYING
  REVIEW_REQUIRED
  IMPORTING
  DONE
  FAILED
}

enum IngestionFileRole {
  EXAM_DOC
  LISTENING_KEY_DOC
  READING_KEY_IMAGE
  AUDIO_FILE
  UNKNOWN
}

model UploadedFile {
  id            String   @id @default(uuid())
  testId        String
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  fileType      String   // EXAM_PDF, KEY_LC_PDF, KEY_RC_IMAGE, AUDIO_MP3
  fileName      String
  filePath      String
  extractedText String?  @db.Text
  mimeType      String
  createdAt     DateTime @default(now())
}

model TestPart {
  id             String          @id @default(uuid())
  testId         String
  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  partNumber     Int
  title          String
  instructions   String?
  audioUrl       String?
  questions      Question[]
  questionGroups QuestionGroup[]
}

model QuestionGroup {
  id         String   @id @default(uuid())
  testPartId String
  testPart   TestPart @relation(fields: [testPartId], references: [id], onDelete: Cascade)
  passage    String?  @db.Text
  transcript String?  @db.Text
  audioUrl   String?
  imageUrl   String?
  textRegions Json?
  groupOrder Int      @default(0)
  images     QuestionGroupImage[]
  questions  Question[]
}

model QuestionGroupImage {
  id              String        @id @default(uuid())
  questionGroupId String
  questionGroup   QuestionGroup @relation(fields: [questionGroupId], references: [id], onDelete: Cascade)
  order           Int           @default(0)
  imageUrl        String
  textRegions     Json?
  sourcePage      Int?
  createdAt       DateTime      @default(now())
}

model Question {
  id              String         @id @default(uuid())
  testPartId      String
  testPart        TestPart       @relation(fields: [testPartId], references: [id], onDelete: Cascade)
  questionGroupId String?
  questionGroup   QuestionGroup? @relation(fields: [questionGroupId], references: [id], onDelete: SetNull)
  questionNumber  Int
  passage         String?        @db.Text
  questionText    String
  image           String?
  transcript      String?        @db.Text
  audioUrl        String?
  correctAnswer   String
  options         Option[]
  answers         Answer[]
  selectedWords   SelectedWord[]
  analysis        QuestionAnalysis?
  vocabularyItems QuestionVocabulary[]
}

model QuestionAnalysis {
  id          String    @id @default(uuid())
  questionId  String    @unique
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  explanation String?   @db.Text
  grammar     String?   @db.Text
  translation String?   @db.Text
  difficulty  String?
  status      String    @default("pending")
  generatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model QuestionVocabulary {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  word       String
  meaning    String?
  ipa        String?
  example    String?  @db.Text
  level      String?
  createdAt  DateTime @default(now())

  @@unique([questionId, word])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  letter     String // "A", "B", "C", "D"
  text       String
}

model TestAttempt {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId          String
  test            Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  score           Int            @default(0)
  listeningScore  Int            @default(0)
  readingScore    Int            @default(0)
  scopePartNumber Int?
  status          String         @default("STARTED") // "STARTED", "COMPLETED"
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  answers         Answer[]
  selectedWords   SelectedWord[]
}

model Answer {
  id                    String      @id @default(uuid())
  testAttemptId         String
  testAttempt           TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  questionId            String
  question              Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption        String // "A", "B", "C", "D"
  isCorrect             Boolean
  aiExplanation         String?     @db.Text
  aiExplanationStatus   String      @default("pending")
  aiGeneratedAt         DateTime?
}

model SelectedWord {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  testAttemptId   String
  testAttempt     TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  word            String
  sentenceContext String
  partNumber      Int
  meaningVi       String?     @db.Text
  example         String?     @db.Text
  synonyms        Json?
  aiStatus        String      @default("pending")
  aiGeneratedAt   DateTime?
  createdAt       DateTime    @default(now())
}

model UserVocabulary {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word            String
  sentenceContext String?
  partNumber      Int?
  status          String   @default("new") // "new", "learning", "mastered"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, word])
}

model IngestionJob {
  id             String          @id @default(uuid())
  testId         String
  createdById    String
  status         IngestionStatus @default(QUEUED)
  progressStep   String?
  confidence     Float?
  reviewRequired Boolean         @default(false)
  errorMessage   String?         @db.Text
  lastFailedStep String?
  resultSummary  String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  test       Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  createdBy  User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  files      IngestionFile[]
  draft      IngestionDraft?
}

model IngestionFile {
  id                String            @id @default(uuid())
  ingestionJobId    String
  originalName      String
  mimeType          String
  storageKey        String
  detectedRole      IngestionFileRole @default(UNKNOWN)
  confidence        Float?
  extractionSummary String?           @db.Text
  createdAt         DateTime          @default(now())

  ingestionJob IngestionJob @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade)
}

model IngestionDraft {
  id                 String   @id @default(uuid())
  ingestionJobId     String   @unique
  canonicalJson      Json
  classificationJson Json?
  parsedToeicJson    Json?
  pipelineState      Json?
  reviewPayload      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ingestionJob IngestionJob @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade)
}
